# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Site URL (use actual domain in production)
NEXT_PUBLIC_SITE_URL=https://virtuserveva.com

# Calendly Integration
# Get your Calendly URL from: https://calendly.com/event_types/user/me
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/virtuserve/discovery-call

# Google Analytics Configuration
# Get your GA4 Measurement ID from: https://analytics.google.com/
# Navigate to: Admin > Data Streams > Web > Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Configuration
# Get your GTM ID from: https://tagmanager.google.com/
# Navigate to: Admin > Install Google Tag Manager
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console Verification
# Get this from: https://search.google.com/search-console
# Navigate to: Settings > Ownership verification > HTML tag method
# Copy only the content value (without quotes or meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code-here
